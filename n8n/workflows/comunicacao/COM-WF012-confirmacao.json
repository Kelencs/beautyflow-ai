      "parameters": {
        "jsCode": "const e=$json;\n\nconst telefoneSanitizado=String(e.telefone_cliente||'').replace(/\\D/g,'');\nconst temTelefone=telefoneSanitizado.length>0;\nconst temPhoneNumberId=!!(e.phone_number_id&&String(e.phone_number_id).trim());\n\nconst FALLBACK='Olá! Recebemos sua solicitação e nossa equipe já está cuidando disso. Em breve entraremos em contato.';\nconst temRespostaCliente=!!(e.resposta_cliente&&String(e.resposta_cliente).trim());\nconst mensagemFinal=temRespostaCliente?String(e.resposta_cliente).trim():FALLBACK;\n\nlet podeEnviar=true;\nlet motivoErroValidacao='';\nif(!temTelefone){\n  podeEnviar=false;\n  motivoErroValidacao='Telefone do cliente vazio ou inválido.';\n}else if(!temPhoneNumberId){\n  podeEnviar=false;\n  motivoErroValidacao='phone_number_id ausente.';\n}\n\nreturn [{json:{\n  id_empresa:e.id_empresa||'EMP001',\n  id_cliente:e.id_cliente||'',\n  id_agendamento:e.id_agendamento||'',\n  telefone_cliente:telefoneSanitizado,\n  nome_cliente:e.nome_cliente||'Cliente',\n  mensagem_texto:e.mensagem_texto||'',\n  intencao:e.intencao||'',\n  confianca:e.confianca,\n  servico:e.servico||'',\n  data:e.data||'',\n  hora_inicio:e.hora_inicio||'',\n  periodo:e.periodo||'',\n  profissional:e.profissional||'',\n  origem:e.origem||'WHATSAPP',\n  phone_number_id:e.phone_number_id||'',\n  dados:e.dados||{},\n  resposta_cliente:e.resposta_cliente||'',\n  mensagem_final:mensagemFinal,\n  usou_fallback:!temRespostaCliente,\n  pode_enviar:podeEnviar,\n  motivo_erro_validacao:motivoErroValidacao\n}}];"
      },
