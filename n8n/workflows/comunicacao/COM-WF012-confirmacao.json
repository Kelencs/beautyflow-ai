        "jsCode": "const m=$('CODE - Montar Mensagem').first().json;\nconst resp=$json||{};\nconst messageId=(resp.messages&&resp.messages[0]&&resp.messages[0].id)||'';\n\nreturn [{json:{...m,status:'ENVIADA',enviado:true,whatsapp_message_id:messageId,erro:''}}];"
      },
