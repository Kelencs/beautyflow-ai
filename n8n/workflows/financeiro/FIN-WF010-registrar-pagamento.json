    {
      "parameters": {
        "jsCode": "function normalizarValorMonetario(v) {\n  if (typeof v === 'number') return isFinite(v) ? v : NaN;\n  if (v === null || v === undefined) return NaN;\n  let s = String(v).trim();\n  if (s === '') return NaN;\n  s = s.replace(/R\\$\\s?/gi, '').trim();\n  if (s.includes(',') && s.includes('.')) {\n    // formato BR completo: \".\" é separador de milhar, \",\" é separador decimal\n    s = s.replace(/\\./g, '').replace(',', '.');\n  } else if (s.includes(',')) {\n    // só vírgula: separador decimal BR (ex.: \"100,00\")\n    s = s.replace(',', '.');\n  }\n  // só ponto ou nenhum separador: já compatível com Number() (ex.: \"100\", \"100.50\")\n  const n = Number(s);\n  return isFinite(n) ? n : NaN;\n}\n\nconst d = $('CODE - Validar Valor Pago').first().json;\nconst candidatos = $items('GS - Buscar Agendamento').map(i => i.json).filter(x => x && x.ID_AGENDAMENTO);\n\nif (candidatos.length === 0) {\n  return [{ json: { ...d, agendamento_ok: false, evento_resultado: 'AGENDAMENTO_NAO_ENCONTRADO', node_origem: 'CODE - Avaliar Agendamento', erro: 'Agendamento não encontrado para esta empresa.' } }];\n}\nif (candidatos.length > 1) {\n  return [{ json: { ...d, agendamento_ok: false, evento_resultado: 'AGENDAMENTO_NAO_ENCONTRADO', node_origem: 'CODE - Avaliar Agendamento', erro: `Foram encontrados ${candidatos.length} agendamentos com o mesmo ID_AGENDAMENTO - inconsistência de dados, registro bloqueado.` } }];\n}\n\nconst ag = candidatos[0];\nif (String(ag.STATUS || '').toUpperCase() === 'CANCELADO') {\n  return [{ json: { ...d, agendamento_ok: false, evento_resultado: 'AGENDAMENTO_CANCELADO', node_origem: 'CODE - Avaliar Agendamento', erro: 'Não é possível registrar pagamento para um agendamento cancelado.' } }];\n}\n\nconst valorTotal = normalizarValorMonetario(ag.VALOR);\nif (isNaN(valorTotal)) {\n  return [{ json: { ...d, agendamento_ok: false, evento_resultado: 'VALOR_INVALIDO', node_origem: 'CODE - Avaliar Agendamento', erro: `Valor do agendamento (AGENDAMENTOS.VALOR=\"${ag.VALOR}\") não pôde ser interpretado como um número válido.` } }];\n}\n\nreturn [{ json: { ...d, agendamento_ok: true, valor_total: valorTotal, id_cliente: d.id_cliente || ag.ID_CLIENTE || '' } }];\n"
      },
