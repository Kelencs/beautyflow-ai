    {
      "parameters": {
        "jsCode": "const d = $json;\nconst bruto = d.valor_pago_raw;\nconst numero = typeof bruto === 'number' ? bruto : Number(String(bruto ?? '').trim().replace(',', '.'));\nconst valido = bruto !== undefined && bruto !== null && String(bruto).trim() !== '' && !isNaN(numero) && isFinite(numero);\n\nconst base = {\n  id_empresa: d.id_empresa,\n  id_agendamento: d.id_agendamento,\n  id_cliente: d.id_cliente,\n  forma_pagamento: d.forma_pagamento,\n  observacoes: d.observacoes,\n  origem: d.origem,\n  dados: d.dados\n};\n\nif (!valido) {\n  return [{ json: { ...base, valor_pago: 0, pagamento_valido: false, evento_resultado: 'VALOR_INVALIDO', node_origem: 'CODE - Validar Valor Pago', erro: 'Valor pago inválido: não é um número.' } }];\n}\nif (numero <= 0) {\n  return [{ json: { ...base, valor_pago: numero, pagamento_valido: false, evento_resultado: 'VALOR_INVALIDO', node_origem: 'CODE - Validar Valor Pago', erro: 'Valor pago deve ser maior que zero.' } }];\n}\n\nreturn [{ json: { ...base, valor_pago: numero, pagamento_valido: true } }];\n"
