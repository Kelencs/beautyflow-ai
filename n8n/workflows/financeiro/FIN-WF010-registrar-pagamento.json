    {
      "parameters": {
        "jsCode": "const d = $('CODE - Avaliar Agendamento').first().json;\nconst existentes = $items('GS - Buscar Pagamento Existente').map(i => i.json).filter(x => x && x.ID_PAGAMENTO);\n\n// Soma somente valores numéricos válidos já registrados para este agendamento.\n// Pagamentos parciais legítimos geram múltiplas transações (múltiplos ID_PAGAMENTO) -\n// a simples existência de outros registros não é mais tratada como duplicidade.\nconst totalPagoAnterior = existentes.reduce((soma, p) => {\n  const v = Number(p.VALOR_PAGO);\n  return soma + (isNaN(v) ? 0 : v);\n}, 0);\n\nconst valorTotal = Number(d.valor_total || 0);\n\n// Único caso em que reaproveitamos o evento PAGAMENTO_DUPLICADO: o agendamento já está\n// totalmente quitado (soma dos pagamentos anteriores >= valor devido). Não há, na estrutura\n// atual do projeto, um identificador de transação (TRANSACAO_ID nunca é preenchido) que\n// permita detectar a repetição exata de uma mesma transação - essa limitação é aceita e\n// documentada aqui, em vez de bloquear pagamentos parciais legítimos.\nif (totalPagoAnterior >= valorTotal && valorTotal > 0) {\n  return [{ json: {\n    ...d, pode_registrar: false, total_pago_anterior: totalPagoAnterior,\n    evento_resultado: 'PAGAMENTO_DUPLICADO',\n    // O agendamento já está de fato quitado (estado financeiro real), mesmo que ESTA\n    // tentativa de pagamento não tenha sido registrada. status_pagamento reflete o estado\n    // real do agendamento; pagamento_registrado (calculado depois, no SET final) continua\n    // false e id_pagamento continua vazio, pois nenhuma nova linha foi criada em PAGAMENTOS.\n    status_pagamento: 'PAGO',\n    node_origem: 'CODE - Calcular Pagamentos Anteriores',\n    erro: `Este agendamento já está totalmente quitado (total pago: ${totalPagoAnterior}, valor devido: ${valorTotal}); nenhum novo pagamento pode ser registrado.`\n  } }];\n}\n\nreturn [{ json: { ...d, pode_registrar: true, total_pago_anterior: totalPagoAnterior } }];\n"
      },
      "id": "2bdde56b-277e-4ce8-bba0-69f3210e1e7e",
      "name": "CODE - Calcular Pagamentos Anteriores",
      "type": "n8n-nodes-base.code",
