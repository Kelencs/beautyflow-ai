      "id": "05426749-3f66-472a-a8db-29343fdbf50c",
      "name": "IF - Pode Registrar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        22944,
        8672
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('CODE - Calcular Pagamentos Anteriores').first().json;\nconst valorTotal = Number(d.valor_total || 0);\nconst valorPagoAtual = Number(d.valor_pago || 0);\nconst totalPagoAnterior = Number(d.total_pago_anterior || 0);\n\nconst novoTotalPago = Number((totalPagoAnterior + valorPagoAtual).toFixed(2));\n\nif (novoTotalPago > valorTotal) {\n  return [{ json: {\n    ...d, pode_registrar_final: false, evento_resultado: 'VALOR_INVALIDO',\n    node_origem: 'CODE - Calcular Pagamento',\n    erro: `Valor pago (${valorPagoAtual}) somado ao total já pago anteriormente (${totalPagoAnterior}) ultrapassa o valor devido (${valorTotal}). Pagamento não registrado.`\n  } }];\n}\n\nconst valorPendente = Number((valorTotal - novoTotalPago).toFixed(2));\nconst status = valorPendente > 0 ? 'PARCIAL' : 'PAGO';\nconst idPagamento = `PAG${Date.now()}${Math.random().toString(36).slice(2, 8)}`;\nconst agora = DateTime.now().setZone('America/Sao_Paulo').toISO();\n\nreturn [{ json: {\n  ...d,\n  pode_registrar_final: true,\n  ID_PAGAMENTO: idPagamento,\n  ID_EMPRESA: d.id_empresa,\n  ID_AGENDAMENTO: d.id_agendamento,\n  ID_CLIENTE: d.id_cliente,\n  VALOR_TOTAL: valorTotal,\n  VALOR_PAGO: valorPagoAtual,\n  VALOR_PENDENTE: valorPendente,\n  FORMA_PAGAMENTO: d.forma_pagamento,\n  STATUS: status,\n  DATA_HORA: agora,\n  TRANSACAO_ID: '',\n  OBSERVACOES: d.observacoes,\n  status_pagamento: status\n} }];\n"
      },
