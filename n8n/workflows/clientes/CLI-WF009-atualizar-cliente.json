    {
      "parameters": {
        "jsCode": "const novo=$json; // saida de CODE - Avaliar Cliente Encontrado (dados normalizados + cliente_atual)\nconst atual=novo.cliente_atual;\nconst agora=DateTime.now().setZone('America/Sao_Paulo').toISO();\n\nfunction mesclar(valorNovo,valorAtual){\n  const vazio=valorNovo===undefined||valorNovo===null||String(valorNovo).trim()==='';\n  return vazio ? (valorAtual||'') : valorNovo;\n}\n\nconst nomeFinal=mesclar(novo.nome_cliente,atual.NOME);\nconst telefoneFinal=mesclar(novo.telefone_cliente,atual.TELEFONE);\n\nreturn [{json:{\n  // colunas da planilha (somente as que de fato serao escritas)\n  ID_CLIENTE:atual.ID_CLIENTE,\n  NOME:nomeFinal,\n  TELEFONE:telefoneFinal,\n  EMAIL:mesclar(novo.email,atual.EMAIL),\n  DATA_NASCIMENTO:mesclar(novo.data_nascimento,atual.DATA_NASCIMENTO),\n  OBSERVACOES:mesclar(novo.observacoes,atual.OBSERVACOES),\n  STATUS:mesclar(novo.status,atual.STATUS),\n  ULTIMA_ATUALIZACAO:agora,\n  // campos de negocio para o restante do fluxo (nao vao para o Sheets)\n  id_empresa:atual.ID_EMPRESA,\n  id_cliente:atual.ID_CLIENTE,\n  nome_cliente:nomeFinal,\n  telefone_cliente:telefoneFinal,\n  origem:novo.origem,\n  dados:novo.dados\n}}];"
      },
