      "id": "428a7855-1806-4814-8df8-2bafacc5d13c",
      "name": "SET - Preparar Atualização",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3872,
        3280
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$('SET - Preparar Atualização').first().json;\nconst err=$json.error||{};\n\nreturn [{json:{\n  id_empresa:d.id_empresa,\n  id_cliente:d.id_cliente,\n  nome_cliente:d.nome_cliente,\n  telefone_cliente:d.telefone_cliente,\n  origem:d.origem,\n  dados:d.dados,\n  cliente_atualizado:false,\n  status_atualizacao:'ERRO_ATUALIZACAO',\n  erro:String((err&&err.message)||err||'Falha técnica ao buscar o cliente para atualização.')\n}}];"
      },
      "id": "3782dd85-8aca-4804-84d7-50c613889f96",
      "name": "CODE - Preparar Erro Busca",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        3536
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$('SET - Preparar Atualização').first().json;\nconst candidatosEmpresa=$items('GS - Buscar Cliente').map(i=>i.json).filter(x=>x&&x.ID_CLIENTE);\n\nlet candidatos=[];\nif(d.id_cliente){\n  // prioridade absoluta: ID_EMPRESA + ID_CLIENTE\n  candidatos=candidatosEmpresa.filter(c=>String(c.ID_CLIENTE)===String(d.id_cliente));\n}else if(d.telefone_cliente){\n  // fallback: telefone normalizado (mesmo padrao do WF008)\n  candidatos=candidatosEmpresa.filter(c=>String(c.TELEFONE||'')===String(d.telefone_cliente));\n}\n\nconst total=candidatos.length;\nreturn [{json:{\n  ...d,\n  pode_atualizar:total===1,\n  status_localizacao: total===0 ? 'CLIENTE_NAO_ENCONTRADO' : (total>1 ? 'MULTIPLOS_CLIENTES_ENCONTRADOS' : 'ENCONTRADO'),\n  total_encontrados:total,\n  cliente_atual:candidatos[0]||null\n}}];"
      },
      "id": "d3de0b35-9a86-4f7a-8f2e-f5b3521a2b08",
      "name": "CODE - Avaliar Cliente Encontrado",
      "type": "n8n-nodes-base.code",
