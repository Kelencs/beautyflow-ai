    },
    {
      "parameters": {
        "jsCode": "const a=$json; // saida de CODE - Avaliar Cliente Encontrado\n\nreturn [{json:{\n  id_empresa:a.id_empresa,\n  id_cliente:a.id_cliente||'',\n  nome_cliente:a.nome_cliente||'',\n  telefone_cliente:a.telefone_cliente||'',\n  origem:a.origem,\n  dados:a.dados,\n  cliente_atualizado:false,\n  status_atualizacao:a.status_localizacao,\n  erro: a.status_localizacao==='MULTIPLOS_CLIENTES_ENCONTRADOS'\n    ? `Foram encontrados ${a.total_encontrados} clientes correspondentes; atualização automática bloqueada para evitar alterar o cadastro errado.`\n    : 'Cliente não encontrado para atualização.'\n}}];"
      },
