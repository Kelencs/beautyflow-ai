    {
      "parameters": {
        "jsCode": "const cadastro=$('SET - Preparar Cadastro').first().json;\nconst encontrados=$items('GS - Verificar Duplicidade').map(i=>i.json).filter(x=>x&&x.ID_CLIENTE);\n\nreturn [{json:{\n  id_empresa:cadastro.id_empresa,\n  telefone_cliente:cadastro.telefone_cliente,\n  nome_cliente:cadastro.nome_cliente,\n  origem:cadastro.origem,\n  cliente_existe:encontrados.length>0,\n  multiplos_encontrados:encontrados.length>1,\n  total_encontrados:encontrados.length,\n  cliente_encontrado:encontrados[0]||null\n}}];"
      },
      "id": "75a8ec2d-cc85-4eb5-8d56-a5d01ee1d2b1",
      "name": "CODE - Avaliar Duplicidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2832,
        2176
      ]
    },
    {
      "parameters": {
        "jsCode": "const cadastro=$json; // saida direta de SET - Preparar Cadastro (ramo falso do IF - Telefone Valido)\n\nreturn [{json:{\n  id_cliente:'',\n  id_empresa:cadastro.id_empresa,\n  nome_cliente:cadastro.nome_cliente,\n  telefone_cliente:cadastro.telefone_cliente,\n  origem:cadastro.origem,\n  cliente_novo:false,\n  status_cadastro:'ERRO_CADASTRO',\n  multiplos_encontrados:false,\n  erro:'Telefone inválido: deve conter entre 10 e 15 dígitos numéricos (com DDI e DDD).'\n}}];"
      },
      "id": "fe017a0b-d782-44e9-b45c-cc7238c89874",
      "name": "CODE - Erro Validação Telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2544,
        2672
      ]
    },
    {
      "parameters": {
        "jsCode": "const cadastro=$('SET - Preparar Cadastro').first().json;\nconst err=$json.error||{};\n\nreturn [{json:{\n  id_cliente:'',\n  id_empresa:cadastro.id_empresa,\n  nome_cliente:cadastro.nome_cliente,\n  telefone_cliente:cadastro.telefone_cliente,\n  origem:cadastro.origem,\n  cliente_novo:false,\n  status_cadastro:'ERRO_CADASTRO',\n  multiplos_encontrados:false,\n  erro:String((err&&err.message)||err||'Falha técnica ao verificar/cadastrar o cliente.')\n}}];"
