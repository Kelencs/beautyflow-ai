    {
      "parameters": {
        "jsCode": "const e=$('TRG - Receber Dados WF007').first().json;\nconst lista=$items('GS - Buscar Agendamentos Ativos').map(i=>i.json).filter(x=>x&&x.ID_AGENDAMENTO);\nconst clientePorTelefone=$('GS - Buscar Cliente por Telefone').first().json;\n\nfunction mesmoDia(raw,alvo){\n  if(!raw||!alvo) return true;\n  const parse=v=>{\n    let dt=DateTime.fromFormat(String(v),'dd/MM/yyyy');\n    if(!dt.isValid) dt=DateTime.fromFormat(String(v),'yyyy-MM-dd');\n    if(!dt.isValid) dt=DateTime.fromISO(String(v));\n    return dt;\n  };\n  const a=parse(raw), b=parse(alvo);\n  return a.isValid&&b.isValid&&a.hasSame(b,'day');\n}\n\nconst base={\n  id_empresa:e.id_empresa||'EMP001',\n  id_cliente:e.id_cliente||'',\n  telefone_cliente:e.telefone_cliente||'',\n  nome_cliente:e.nome_cliente||'Cliente',\n  origem:e.origem||'WHATSAPP',\n  phone_number_id:e.phone_number_id||'',\n  mensagem_texto:e.mensagem_texto||'',\n  intencao:e.intencao||'',\n  confianca:e.confianca,\n  dados:e.dados||{},\n  motivo_cancelamento:e.motivo_cancelamento||'Cancelado a pedido do cliente'\n};\n\nlet candidatos=[];\n\nif(e.id_agendamento){\n  // prioridade absoluta: id_agendamento informado\n  candidatos=lista.filter(a=>String(a.ID_AGENDAMENTO)===String(e.id_agendamento));\n}else{\n  const idClienteResolvido=e.id_cliente||(clientePorTelefone&&clientePorTelefone.ID_CLIENTE)||'';\n  if(!idClienteResolvido){\n    return [{json:{...base,encontrado:false,status:'NAO_ENCONTRADO',resposta_cliente:'Não encontrei nenhum agendamento ativo para cancelar. Pode confirmar os dados do agendamento?'}}];\n  }\n  candidatos=lista.filter(a=>String(a.ID_CLIENTE)===String(idClienteResolvido));\n  if(e.data){\n    candidatos=candidatos.filter(a=>mesmoDia(a.DATA,e.data));\n  }\n}\n\nif(candidatos.length===0){\n  return [{json:{...base,encontrado:false,status:'NAO_ENCONTRADO',resposta_cliente:'Não encontrei nenhum agendamento ativo para cancelar. Pode confirmar os dados do agendamento?'}}];\n}\n\nif(candidatos.length>1){\n  const opcoes=candidatos.slice(0,6).map(a=>`${a.DATA} às ${String(a.HORA_INICIO||'').slice(0,5)}`).join('; ');\n  return [{json:{...base,encontrado:false,status:'MULTIPLOS_AGENDAMENTOS',resposta_cliente:`Encontrei mais de um agendamento ativo: ${opcoes}. Pode me dizer qual deles você quer cancelar (data e horário)?`}}];\n}\n\nconst a=candidatos[0];\nreturn [{json:{...base,encontrado:true,status:'ENCONTRADO',\n  id_agendamento:a.ID_AGENDAMENTO,\n  id_cliente:a.ID_CLIENTE||base.id_cliente,\n  id_profissional:a.ID_PROFISSIONAL||'',\n  servico:a.ID_SERVICO||'',\n  data:a.DATA,\n  hora_inicio:String(a.HORA_INICIO||'').slice(0,5),\n  google_event_id:a.GOOGLE_EVENT_ID||'',\n  resposta_cliente:''\n}}];"
      },
