        "jsCode": "const a=$('CODE - Localizar Agendamento').first().json;\nconst err=$json.error||{};\n\nreturn [{json:{\n  id_empresa:a.id_empresa,\n  id_cliente:a.id_cliente,\n  telefone_cliente:a.telefone_cliente,\n  nome_cliente:a.nome_cliente,\n  id_agendamento:a.id_agendamento,\n  data:a.data,\n  hora_inicio:a.hora_inicio,\n  origem:a.origem,\n  phone_number_id:a.phone_number_id,\n  mensagem_texto:a.mensagem_texto,\n  intencao:a.intencao,\n  confianca:a.confianca,\n  dados:a.dados,\n  google_event_id:a.google_event_id,\n  status:'ERRO_TECNICO',\n  erro:String((err&&err.message)||err||'Falha técnica ao cancelar o agendamento.'),\n  resposta_cliente:'Tivemos um problema técnico ao cancelar seu agendamento. Por favor, tente novamente em alguns instantes ou fale com a nossa equipe.'\n}}];"
