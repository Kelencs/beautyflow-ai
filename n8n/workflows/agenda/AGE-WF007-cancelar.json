    {
      "parameters": {
        "jsCode": "const a=$('CODE - Localizar Agendamento').first().json;\nconst emp=$('GS - Buscar Empresa').first().json;\n\nfunction parseDataHora(dataStr,horaStr){\n  let dt=DateTime.fromFormat(`${dataStr} ${horaStr}`,'dd/MM/yyyy HH:mm');\n  if(!dt.isValid) dt=DateTime.fromFormat(`${dataStr} ${horaStr}`,'yyyy-MM-dd HH:mm');\n  if(!dt.isValid) dt=DateTime.fromISO(`${dataStr}T${horaStr}`);\n  return dt;\n}\n\nconst inicio=parseDataHora(a.data,String(a.hora_inicio||'00:00').slice(0,5));\nconst agora=DateTime.now();\nconst minutosAte=inicio.isValid?inicio.diff(agora,'minutes').minutes:null;\nconst prazoMin=Number((emp&&emp.TEMPO_CANCELAMENTO_MIN)||0);\n\nconst dentroDoPrazo=minutosAte!==null&&minutosAte>=prazoMin;\n\nif(!dentroDoPrazo){\n  return [{json:{...a,dentro_do_prazo:false,status:'FORA_PRAZO_CANCELAMENTO',minutos_ate_agendamento:minutosAte,resposta_cliente:`Infelizmente não é possível cancelar automaticamente esse agendamento porque estamos fora do prazo de ${prazoMin} minutos de antecedência. Entre em contato com a equipe para verificar a possibilidade de cancelamento.`}}];\n}\n\nreturn [{json:{...a,dentro_do_prazo:true,status:'DENTRO_DO_PRAZO',minutos_ate_agendamento:minutosAte}}];"
      },
