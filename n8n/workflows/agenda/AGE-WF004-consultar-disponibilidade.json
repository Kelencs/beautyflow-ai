    {
      "parameters": {
        "jsCode": "const e=$('TRG - Receber Dados WF004').first().json;\nconst s=$('GS - Buscar Serviço').first().json;\nconst p=$('GS - Buscar Profissional').first().json;\nconst ds=$items('GS - Buscar Disponibilidade').map(i=>i.json);\nconst ag=$items('GS - Buscar Agendamentos').map(i=>i.json);\nconst dur=Number(s.DURACAO_MIN||60), intervalo=Number(s.TEMPO_INTERVALO_MIN||0);\nconst tm=t=>{const [h,m]=String(t||'00:00').slice(0,5).split(':').map(Number);return h*60+m};\nconst hs=m=>String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');\nconst dia=new Date(`${e.data}T12:00:00`).getDay();\nconst d=ds.find(x=>Number(x.DIA_SEMANA_NUM)===dia)||ds[0];\nif(!d)return [{json:{status:'SEM_DISPONIBILIDADE',horarios:[],resposta_cliente:'Não encontrei disponibilidade cadastrada.'}}];\nconst occ=ag.filter(a=>!['CANCELADO'].includes(String(a.STATUS||'').toUpperCase())).map(a=>[tm(a.HORA_INICIO),tm(a.HORA_FIM)]);\nconst ini=tm(d.HORA_INICIO), fim=tm(d.HORA_FIM), pi=d.INTERVALO_INICIO?tm(d.INTERVALO_INICIO):null, pf=d.INTERVALO_FIM?tm(d.INTERVALO_FIM):null;\nconst horarios=[]; for(let x=ini;x+dur<=fim;x+=30){const y=x+dur+intervalo; if(!(pi!==null&&x<pf&&y>pi)&&!occ.some(([a,b])=>x<b&&y>a)) horarios.push(hs(x));}\nreturn [{json:{...e,id_servico:s.ID_SERVICO,servico:s.NOME,duracao_min:dur,valor:Number(s.VALOR||0),id_profissional:p.ID_PROFISSIONAL,profissional:p.NOME,horarios,resposta_cliente:horarios.length?`Horários disponíveis: ${horarios.slice(0,6).join(', ')}`:'Não encontrei horários livres.'}}];"
      },
