    {
      "parameters": {
        "jsCode": "const v=$('CODE - Validar Disponibilidade').first().json;\nconst err=$json.error||{};\n\nreturn [{json:{\n  id_empresa:v.id_empresa,\n  id_cliente:v.id_cliente,\n  telefone_cliente:v.telefone_cliente,\n  nome_cliente:v.nome_cliente,\n  servico:v.servico,\n  data:v.data,\n  hora_inicio:v.hora_inicio,\n  periodo:v.periodo,\n  origem:v.origem,\n  phone_number_id:v.phone_number_id,\n  mensagem_texto:v.mensagem_texto,\n  intencao:v.intencao,\n  confianca:v.confianca,\n  dados:v.dados,\n  id_profissional:v.id_profissional,\n  profissional:v.profissional,\n  duracao_min:v.duracao_min,\n  valor:v.valor,\n  status:'ERRO_TECNICO',\n  erro:String((err&&err.message)||err||'Falha técnica ao confirmar o agendamento.'),\n  resposta_cliente:'Tivemos um problema técnico ao confirmar seu agendamento. Por favor, tente novamente em alguns instantes ou fale com a nossa equipe.'\n}}];"
      },
