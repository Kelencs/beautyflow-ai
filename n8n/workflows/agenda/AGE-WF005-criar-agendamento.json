      "typeVersion": 1.2,
      "position": [
        -240,
        992
      ]
    },
    {
      "parameters": {
        "jsCode": "const entrada = $('TRG - Receber Dados WF005').first().json;\nconst disponibilidade = $('EXEC - WF004 - Consultar Disponibilidade').first().json;\n\nconst idAgendamento = `AGE${Date.now().toString().slice(-9)}`;\n\nconst duracaoMin = Number(\n  disponibilidade.duracao_min ||\n  entrada.duracao_min ||\n  entrada.duracao ||\n  60\n);\n\nconst valor = Number(\n  disponibilidade.valor ||\n  entrada.valor ||\n  0\n);\n\nconst data = entrada.data || disponibilidade.data;\nconst horaInicio = entrada.hora_inicio;\n\nif (!data) {\n  throw new Error('A data do agendamento está vazia.');\n}\n\nif (!horaInicio) {\n  throw new Error('A hora inicial do agendamento está vazia.');\n}\n\nfunction adicionarMinutos(horario, minutos) {\n  const [hora, minuto] = horario.split(':').map(Number);\n\n  const total = hora * 60 + minuto + minutos;\n\n  const horaFinal = Math.floor(total / 60) % 24;\n  const minutoFinal = total % 60;\n\n  return `${String(horaFinal).padStart(2, '0')}:${String(minutoFinal).padStart(2, '0')}`;\n}\n\nconst horaFim = adicionarMinutos(horaInicio, duracaoMin);\nconst agora = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      ID_AGENDAMENTO: idAgendamento,\n\n      ID_EMPRESA: entrada.id_empresa || 'EMP001',\n      ID_CLIENTE: entrada.id_cliente || '',\n      ID_PROFISSIONAL:\n        entrada.id_profissional ||\n        disponibilidade.id_profissional ||\n        '',\n      ID_SERVICO:\n        entrada.id_servico ||\n        disponibilidade.id_servico ||\n        '',\n\n      DATA: data,\n      HORA_INICIO: horaInicio,\n      DURACAO_MIN: duracaoMin,\n      HORA_FIM: horaFim,\n      VALOR: valor,\n\n      STATUS: 'AGENDADO',\n      ORIGEM: entrada.origem || 'WHATSAPP',\n      OBSERVACOES: entrada.observacoes || '',\n\n      GOOGLE_EVENT_ID: '',\n\n      DATA_CRIACAO: agora,\n      ULTIMA_ATUALIZACAO: agora,\n\n      DATA_CANCELAMENTO: '',\n      MOTIVO_CANCELAMENTO: '',\n\n      nome_cliente: entrada.nome_cliente || 'Cliente',\n      telefone_cliente: entrada.telefone_cliente || '',\n      servico:\n        entrada.servico ||\n        disponibilidade.servico ||\n        '',\n      profissional:\n        entrada.profissional ||\n        disponibilidade.profissional ||\n        ''\n    }\n  }\n];"
      },
