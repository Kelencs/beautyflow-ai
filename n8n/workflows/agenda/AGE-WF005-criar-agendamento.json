    {
      "parameters": {
        "jsCode": "const v=$('CODE - Validar Disponibilidade').first().json;\n\nconst idAgendamento=`AGE${Date.now().toString().slice(-9)}`;\nconst agora=new Date().toISOString();\n\nreturn [\n  {\n    json:{\n      ID_AGENDAMENTO:idAgendamento,\n      ID_EMPRESA:v.id_empresa,\n      ID_CLIENTE:v.id_cliente,\n      ID_PROFISSIONAL:v.id_profissional,\n      ID_SERVICO:v.id_servico,\n      DATA:v.data,\n      HORA_INICIO:v.hora_inicio,\n      DURACAO_MIN:v.duracao_min,\n      HORA_FIM:v.hora_fim,\n      VALOR:v.valor,\n      STATUS:'AGENDADO',\n      ORIGEM:v.origem,\n      OBSERVACOES:v.observacoes||'',\n      GOOGLE_EVENT_ID:'',\n      DATA_CRIACAO:agora,\n      ULTIMA_ATUALIZACAO:agora,\n      DATA_CANCELAMENTO:'',\n      MOTIVO_CANCELAMENTO:'',\n      nome_cliente:v.nome_cliente,\n      telefone_cliente:v.telefone_cliente,\n      servico:v.servico,\n      profissional:v.profissional,\n      periodo:v.periodo,\n      phone_number_id:v.phone_number_id,\n      mensagem_texto:v.mensagem_texto,\n      intencao:v.intencao,\n      confianca:v.confianca,\n      dados:v.dados\n    }\n  }\n];"
      },
