    {
      "parameters": {
        "jsCode": "const e=$('TRG - Receber Dados WF005').first().json;\nconst d=$('EXEC - WF004 - Consultar Disponibilidade').first().json;\n\nconst horarios=Array.isArray(d.horarios)?d.horarios:[];\nconst duracaoMin=Number(d.duracao_min||60);\n\nconst tm=t=>{const [h,m]=String(t||'00:00').slice(0,5).split(':').map(Number);return h*60+m};\nconst hs=m=>String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');\n\nconst base={\n  id_empresa:e.id_empresa||'EMP001',\n  id_cliente:e.id_cliente||'',\n  telefone_cliente:e.telefone_cliente||'',\n  nome_cliente:e.nome_cliente||'Cliente',\n  servico:d.servico||e.servico||'',\n  data:e.data||d.data||'',\n  periodo:e.periodo||'',\n  origem:e.origem||'WHATSAPP',\n  phone_number_id:e.phone_number_id||'',\n  mensagem_texto:e.mensagem_texto||'',\n  intencao:e.intencao||'',\n  confianca:e.confianca,\n  dados:e.dados||{},\n  id_profissional:d.id_profissional||e.id_profissional||'',\n  profissional:d.profissional||e.profissional||'',\n  id_servico:d.id_servico||'',\n  duracao_min:duracaoMin,\n  valor:Number(d.valor||0)\n};\n\nif(d.status!=='OK'||horarios.length===0){\n  return [{json:{...base,pode_agendar:false,status:'SEM_DISPONIBILIDADE',hora_inicio:'',resposta_cliente:d.resposta_cliente||'Não encontrei horários disponíveis para esse atendimento. Podemos tentar outra data ou horário?'}}];\n}\n\nlet horaEscolhida=null;\nif(e.hora_inicio){\n  const alvo=String(e.hora_inicio).slice(0,5);\n  horaEscolhida=horarios.find(h=>h===alvo)||null;\n  if(!horaEscolhida){\n    return [{json:{...base,pode_agendar:false,status:'HORARIO_INDISPONIVEL',hora_inicio:alvo,resposta_cliente:`O horário ${alvo} não está mais disponível. Horários livres: ${horarios.slice(0,6).join(', ')}. Qual prefere?`}}];\n  }\n}else{\n  horaEscolhida=horarios[0]; // escolha determinística: primeiro horário livre do dia\n}\n\nconst inicioMin=tm(horaEscolhida);\nconst fimMin=inicioMin+duracaoMin;\nif(fimMin>24*60){\n  return [{json:{...base,pode_agendar:false,status:'ATRAVESSA_MEIA_NOITE',hora_inicio:horaEscolhida,resposta_cliente:`O horário ${horaEscolhida} não comporta a duração do serviço sem ultrapassar a meia-noite. Horários livres: ${horarios.slice(0,6).join(', ')}. Qual prefere?`}}];\n}\n\nreturn [{json:{...base,pode_agendar:true,status:'DISPONIVEL',hora_inicio:horaEscolhida,hora_fim:hs(fimMin),resposta_cliente:''}}];"
      },
