    {
      "parameters": {
        "jsCode": "const body=$json.body||$json;\nconst value=body?.entry?.[0]?.changes?.[0]?.value||{};\nconst msg=value?.messages?.[0]||null;\nconst contact=value?.contacts?.[0]||{};\nconst meta=value?.metadata||{};\nif(!msg) return [{json:{evento_valido:false,origem:'WHATSAPP'}}];\nreturn [{json:{\n evento_valido:true,\n id_empresa:'EMP001',\n mensagem_id:msg.id||'',\n telefone_cliente:String(msg.from||'').replace(/\\D/g,''),\n nome_cliente:contact?.profile?.name||'Cliente',\n tipo_mensagem:msg.type||'text',\n mensagem_texto:msg?.text?.body||'',\n timestamp:new Date(Number(msg.timestamp||0)*1000).toISOString(),\n phone_number_id:meta.phone_number_id||'',\n origem:'WHATSAPP'\n}}];"
      },
