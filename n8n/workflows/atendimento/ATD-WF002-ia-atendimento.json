    {
      "parameters": {
        "jsCode": "const raw=$json;let p=raw?.intencao?raw:null;\nif(!p){const t=raw?.content?.parts?.[0]?.text??raw?.text??raw?.output??raw?.response??'';try{p=typeof t==='string'?JSON.parse(t.replace(/```json|```/g,'').trim()):t}catch{p={intencao:'OUTRO',confianca:0,servico:'',dados:{},data:'',hora_inicio:'',periodo:'',profissional:'',resposta_cliente:'Desculpe, não consegui compreender. Você deseja agendar, consultar, reagendar ou cancelar?',proximo_fluxo:'RESPOSTA_GERAL'}}}\nconst c=$('MERGE - Cliente').first().json;\nreturn [{json:{id_empresa:c.id_empresa||'EMP001',id_cliente:c.id_cliente||'',telefone_cliente:c.telefone_cliente||'',nome_cliente:c.nome_cliente||'Cliente',mensagem_id:c.mensagem_id||'',tipo_mensagem:c.tipo_mensagem||'text',mensagem_texto:c.mensagem_texto||'',timestamp:c.timestamp||new Date().toISOString(),phone_number_id:c.phone_number_id||'',origem:c.origem||'WHATSAPP',intencao:String(p.intencao||'OUTRO').toUpperCase(),confianca:Number(p.confianca||0),servico:p.servico||'',dados:p.dados||{},data:p.data||'',hora_inicio:p.hora_inicio||p.hora||'',periodo:p.periodo||'',profissional:p.profissional||'',resposta_cliente:p.resposta_cliente||'',proximo_fluxo:p.proximo_fluxo||''}}];"
      },
