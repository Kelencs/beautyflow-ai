              "id": "aa15544d-36cf-4b7b-80e7-0804f05c052a",
              "name": "prompt_beautyflow",
              "value": "={{ `Você é o assistente virtual do BeautyFlow. Analise a mensagem do cliente e retorne somente JSON válido.\\n\\nCliente: ${$('MERGE - Cliente').first().json.nome_cliente}\\nTelefone: ${$('MERGE - Cliente').first().json.telefone_cliente}\\nMensagem: ${$('MERGE - Cliente').first().json.mensagem_texto}\\n\\nFormato obrigatório:\\n{\"intencao\":\"AGENDAR|CONSULTAR_DISPONIBILIDADE|REAGENDAR|CANCELAR|OUTRO\",\"confianca\":0.0,\"servico\":\"\",\"dados\":{},\"data\":\"\",\"hora_inicio\":\"\",\"periodo\":\"\",\"profissional\":\"\",\"resposta_cliente\":\"\",\"proximo_fluxo\":\"\"}` }}",
