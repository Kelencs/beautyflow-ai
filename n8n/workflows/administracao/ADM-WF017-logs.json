    {
      "parameters": {
        "jsCode": "// Normaliza o campo \"dados\" para aceitar workflows diferentes sem quebrar:\n// - todos os chamadores atuais (WF001-WF016) já enviam \"dados\" como uma string JSON\n//   pré-serializada (JSON.stringify(...) do lado de quem chama);\n// - se um chamador futuro enviar um objeto puro, serializa aqui;\n// - se vier vazio/nulo, grava '{}' (nunca deixa a coluna DADOS quebrada ou com \"undefined\").\nconst raw = $json.dados;\nlet dadosStr;\nif (raw === undefined || raw === null || raw === '') {\n  dadosStr = '{}';\n} else if (typeof raw === 'string') {\n  dadosStr = raw;\n} else {\n  try { dadosStr = JSON.stringify(raw); } catch (e) { dadosStr = String(raw); }\n}\n\nreturn [{ json: {\n  ID_LOG: `LOG${Date.now()}${Math.random().toString(36).slice(2, 8)}`,\n  DATA_HORA: $now.toISO(),\n  // Nunca assume uma empresa real por padrão: se o chamador não informar id_empresa,\n  // isso é uma falha de integração que deve ficar visível na planilha, não escondida\n  // atrás de um valor plausível como 'EMP001'.\n  ID_EMPRESA: $json.id_empresa || 'NAO_INFORMADO',\n  WORKFLOW: $json.workflow || '',\n  NODE: $json.node || '',\n  // Mesmo raciocínio: um TIPO ausente não deve virar silenciosamente 'INFO'\n  // (isso mascararia um evento potencialmente crítico que o chamador esqueceu de classificar).\n  TIPO: String($json.tipo || 'NAO_INFORMADO').toUpperCase(),\n  EVENTO: $json.evento || '',\n  // Mesmo raciocínio: um STATUS ausente não deve virar silenciosamente 'PROCESSADO'\n  // (pareceria sucesso mesmo quando o chamador não informou nada).\n  STATUS: String($json.status || 'NAO_INFORMADO').toUpperCase(),\n  MENSAGEM: $json.mensagem || '',\n  DADOS: dadosStr,\n  EXECUTION_ID: $json.execution_id || $execution.id || ''\n} }];\n"
      },
