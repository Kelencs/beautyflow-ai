# BeautyFlow App — Backend (NestJS)
#
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione .env nem coloque segredos reais neste arquivo .env.example.
#
# Nenhuma dessas integrações está configurada ainda na Fase 0A (fundação do
# monorepo) — os nomes abaixo documentam o que será necessário a partir da
# Fase 0B, conforme o plano de arquitetura aprovado.

PORT=3001
NODE_ENV=development

# --- Supabase (Auth + Postgres para usuários/papéis — configurado na Fase 0B) ---
# Chave de service role: acesso privilegiado, nunca exposta ao frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway n8n (APP-WF019 — workflow ainda não existe, ver plano de arquitetura) ---
N8N_GATEWAY_URL=
N8N_GATEWAY_API_KEY=
